# Copy this file to .env.local and fill in the key to enable AI input.
# The key is only used on the server (src/app/api/estimate/route.ts).
DEEPSEEK_API_KEY=
# Optional: defaults to deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash

# Where accounts, sessions and diaries are stored (JSON files).
# Relative paths start from the project folder. Default: ./data
DATA_DIR=data

# Set to false once everyone has an account, to turn off "Create account".
ALLOW_SIGNUP=true

# Who can open the admin page (Profile > Admin): usernames, comma separated.
# Empty means nobody. Example: ADMIN_USERNAMES=sam,alex
ADMIN_USERNAMES=
